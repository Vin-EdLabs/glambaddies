# =============================================================================
# GlamBaddies — production template
# Copy to .env on the server and fill secrets (JWT, DB password, Paystack, SMTP).
# For local development, override CLIENT_URL / FRONTEND_URL / NODE_ENV as needed.
# =============================================================================

# Server
PORT=3100
NODE_ENV=production
APP_NAME=GlamBaddies
APP_URL=https://www.glambaddies.com
CLIENT_URL=https://www.glambaddies.com
FRONTEND_URL=https://www.glambaddies.com
BASE_URL=https://www.glambaddies.com
DB_NAME=glambaddies_db

# Local overrides (uncomment for local machine):
# NODE_ENV=development
# CLIENT_URL=http://localhost:5173
# FRONTEND_URL=http://localhost:5173
# APP_URL=http://localhost:5173
# BASE_URL=http://localhost:3100

# PostgreSQL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/glambaddies_db
# PGHOST=localhost
# PGPORT=5432
# PGDATABASE=glambaddies_db
# PGUSER=postgres
# PGPASSWORD=postgres

# Customer JWT
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d

# Admin JWT (must be different from JWT_SECRET)
# Admin UI/API path: /glam-baddies  (login: /glam-baddies/login, API: /api/glam-baddies)
ADMIN_JWT_SECRET=replace-with-a-different-long-random-string
ADMIN_JWT_EXPIRES_IN=8h

# Paystack — GHS only (no USD conversion)
# Prefer Settings → Payments in /glam-baddies; keys can also live in store_settings.
PAYSTACK_SECRET_KEY=sk_live_your_key_here
PAYSTACK_PUBLIC_KEY=pk_live_your_key_here
PAYSTACK_BASE_URL=https://api.paystack.co
# Dashboard webhook URL: https://www.glambaddies.com/api/webhook/paystack

# Uploads
MAX_UPLOAD_SIZE_MB=15

# Transactional email
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=noreply@glambaddies.com
SMTP_PASS=your-smtp-app-password
SMTP_FROM=GlamBaddies <noreply@glambaddies.com>
MAIL_FROM_NAME=GlamBaddies
MAIL_FROM_ADDRESS=noreply@glambaddies.com
SUPPORT_EMAIL=support@glambaddies.com
