# Server
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173
FRONTEND_URL=http://localhost:5173
# Production example:
# FRONTEND_URL=https://shop.scholarnerve.com
# CLIENT_URL=https://shop.scholarnerve.com

# PostgreSQL (either DATABASE_URL or the individual PG* variables)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/vublishop
# PGHOST=localhost
# PGPORT=5432
# PGDATABASE=vublishop
# PGUSER=postgres
# PGPASSWORD=postgres

# Customer JWT
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d

# Admin JWT (must be different from JWT_SECRET)
ADMIN_JWT_SECRET=replace-with-a-different-long-random-string
ADMIN_JWT_EXPIRES_IN=8h

# Paystack (optional bootstrap — prefer Admin → Settings → Payments in production)
# Keys are stored in store_settings and read on every transaction.
PAYSTACK_SECRET_KEY=sk_test_your_key_here
PAYSTACK_PUBLIC_KEY=pk_test_your_key_here
PAYSTACK_BASE_URL=https://api.paystack.co
# Catalog is USD. Paystack charges USD first; falls back to GHS using this rate.
USD_TO_GHS_RATE=15.5

# Uploads
MAX_UPLOAD_SIZE_MB=5
