# Default: relative /api (works in Vite dev via proxy and in production via Nginx)
VITE_API_URL=/api
VITE_APP_NAME=GlamBaddies
VITE_APP_URL=https://www.glambaddies.com
VITE_PAYSTACK_PUBLIC_KEY=pk_live_your_key_here

# Optional local override if you want to hit the API host directly:
# VITE_API_URL=http://localhost:3100/api
# VITE_PAYSTACK_PUBLIC_KEY=pk_test_your_key
